# Cloudflare Workers static assets: response headers by path (this file is not served).
# Vite's build output in /assets/ has a content hash in every file name, so a file there never changes:
# browsers keep it for a year without asking again. Everything else (pages, sw.js, manifest) keeps the default,
# which revalidates on each visit so a deploy shows up at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
